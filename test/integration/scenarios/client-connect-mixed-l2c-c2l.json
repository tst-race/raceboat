{
  "id": "client-connect-mixed-l2c-c2l",
  "mode": "client-connect",
  "wait_time": 15,
  "timeout": 60,
  "network": {
    "name": "mixed-l2c-c2l-network",
    "subnet": "10.40.1.0/24"
  },
  "linkDirectionOverrides": {
    "twoSixIndirectComposition": {
      "channel": "LD_LOADER_TO_CREATOR"
    },
    "twoSixIndirectCompositionFile": {
      "channel": "LD_CREATOR_TO_LOADER"
    }
  },
  "nodes": [
    {
      "role": "listener",
      "id": "listener",
      "ip": "10.40.1.3",
      "slots": {
        "channel": {
          "recv": "twoSixIndirectComposition",
          "send": "twoSixIndirectCompositionFile"
        }
      }
    },
    {
      "role": "connector",
      "id": "dialer",
      "ip": "10.40.1.2",
      "slots": {
        "channel": {
          "recv": "twoSixIndirectCompositionFile",
          "send": "twoSixIndirectComposition"
        }
      }
    }
  ]
}
