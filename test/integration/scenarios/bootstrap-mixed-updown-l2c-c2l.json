{
  "id": "bootstrap-mixed-updown-l2c-c2l",
  "mode": "bootstrap-connect",
  "wait_time": 20,
  "timeout": 60,
  "network": {
    "name": "bmu-l2c-c2l-network",
    "subnet": "10.36.1.0/24"
  },
  "linkDirectionOverrides": {
    "obfs4": {
      "initial": "LD_LOADER_TO_CREATOR"
    },
    "twoSixIndirectComposition": {
      "initial": "LD_CREATOR_TO_LOADER"
    }
  },
  "nodes": [
    {
      "role": "listener",
      "id": "listener",
      "ip": "10.36.1.3",
      "slots": {
        "initial": {
          "recv": "obfs4",
          "send": "twoSixIndirectComposition"
        },
        "final": {
          "recv": "twoSixIndirectComposition",
          "send": "obfs4"
        }
      }
    },
    {
      "role": "connector",
      "id": "dialer",
      "ip": "10.36.1.2",
      "slots": {
        "initial": {
          "recv": "twoSixIndirectComposition",
          "send": "obfs4"
        },
        "final": {
          "send": "twoSixIndirectComposition",
          "recv": "obfs4"
        }
      }
    }
  ]
}
