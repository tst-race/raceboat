{
  "id": "bootstrap-mixed-updown-l2c-c2l",
  "mode": "bootstrap-connect",
  "wait_time": 20,
  "timeout": 60,
  "network": {"name": "bmu-l2c-c2l-network", "subnet": "10.36.1.0/24"},
  "linkDirectionOverrides": {
    "racebird": { "initial": "LD_LOADER_TO_CREATOR" },
    "decomposed-exemplars": { "initial": "LD_CREATOR_TO_LOADER" }
  },
  "nodes": [
    {
      "role": "listener",
      "id": "listener",
      "ip": "10.36.1.3",
      "slots": {
        "initial": {"recv": "racebird", "send": "decomposed-exemplars"},
        "final": {"recv": "decomposed-exemplars", "send": "racebird"}
      }
    },
    {
      "role": "connector",
      "id": "dialer",
      "ip": "10.36.1.2",
      "slots": {
        "initial": {"recv": "decomposed-exemplars", "send": "racebird"},
        "final": {"send": "decomposed-exemplars", "recv": "racebird"}
      }
    }
  ]
}
