{
  "id": "bootstrap-mixed-initial-downstream-c2l",
  "mode": "bootstrap-connect",
  "wait_time": 20,
  "timeout": 60,
  "network": {
    "name": "bmid-c2l-network",
    "subnet": "10.34.1.0/24"
  },
  "linkDirectionOverrides": {
    "twoSixIndirectComposition": {
      "final": "LD_CREATOR_TO_LOADER"
    }
  },
  "nodes": [
    {
      "role": "listener",
      "id": "listener",
      "ip": "10.34.1.3",
      "slots": {
        "initial": {
          "recv": "obfs4",
          "send": "twoSixIndirectComposition"
        },
        "final": "obfs4"
      }
    },
    {
      "role": "connector",
      "id": "dialer",
      "ip": "10.34.1.2",
      "slots": {
        "initial": {
          "recv": "twoSixIndirectComposition",
          "send": "obfs4"
        },
        "final": "obfs4"
      }
    }
  ]
}
