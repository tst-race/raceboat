{
  "id": "bootstrap-mixed-initial-downstream-c2l",
  "mode": "bootstrap-connect",
  "wait_time": 20,
  "timeout": 60,
  "network": {"name": "bmid-c2l-network", "subnet": "10.34.1.0/24"},
  "linkDirectionOverrides": {
    "decomposed-exemplars": { "final": "LD_CREATOR_TO_LOADER" }
  },
  "nodes": [
    {
      "role": "listener",
      "id": "listener",
      "ip": "10.34.1.3",
      "slots": {
        "initial": {"recv": "racebird", "send": "decomposed-exemplars"},
        "final": "racebird"
      }
    },
    {
      "role": "connector",
      "id": "dialer",
      "ip": "10.34.1.2",
      "slots": {
        "initial": {"recv": "decomposed-exemplars", "send": "racebird"},
        "final": "racebird"
      }
    }
  ]
}
